# OAuth Client ID (Web application) from Google Cloud Console.
# Required for the "Add photos from Google Drive" button; without it
# the button is hidden. See README → Google Drive setup.
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN for error monitoring on production (optional; monitoring
# is disabled on localhost and when unset).
VITE_SENTRY_DSN=

# Feature flags (default off). Any of "true"/"1" turns a flag on at build
# time; a `?ff=googleDrive` / `?ff=-googleDrive` query parameter overrides
# it for a single visit. See src/services/feature-flags.ts.
VITE_FF_GOOGLE_DRIVE=
